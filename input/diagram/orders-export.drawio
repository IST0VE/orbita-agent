          </mxCell>
        </object>
        <mxCell id="note-retention" value="Файлы в S3 живут 7 суток, дальше удаляются lifecycle-правилом" style="shape=note;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e-client-api" value="POST /exports {period, filters, format}" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="client" target="api">
