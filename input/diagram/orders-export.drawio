<mxfile host="app.diagrams.net" agent="orbita-sample" version="24.7.17">
  <diagram id="orders-export-flow" name="Выгрузка заказов">
    <mxGraphModel dx="1102" dy="731" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lane-sync" value="Синхронный контур" style="swimlane;horizontal=0;" vertex="1" parent="1">
