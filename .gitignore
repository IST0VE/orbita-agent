# LangGraph runtime checkpoints (not source — regenerated on every `langgraph dev`)
.langgraph_api/

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.pytest-audit/
.coverage
htmlcov/
.tmp/
.npm-audit-cache/
.pip-audit-cache*/
.venv/
venv/
*.egg-info/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.env
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
.npmrc
.pypirc
credentials.json
service-account*.json
.secrets/

# Данные инструментов и собранные документы: результат прогонов, не исходники
data/
published/
*.jsonl
# ...кроме сырых логов замеров: на них ссылается статья, и без них цифры
# в ней пришлось бы принимать на веру
!docs/measurements/calls-broken-prefix.jsonl
!docs/measurements/calls-stable-prefix.jsonl
!docs/measurements/turns-broken-prefix.jsonl
!docs/measurements/turns-stable-prefix.jsonl

# Локальные входные материалы: никогда не публикуются в репозиторий
input/

# Логи, базы, выгрузки, резервные копии и архивы могут содержать данные пользователей.
*.log
*.har
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.dump
*.bak
*.zip
*.7z
*.tar
*.tar.gz
*.tgz

# Сборки и кеши: общие правила вместо локального .git/info/exclude.
node_modules/
dist/
build/
# ...кроме web/build: это исходники сборки frontend (CSP собирается из
# VITE_API_URL), а не её результат. Правило build/ выше их скрывало.
!web/build/
.astro/
.vite/
.next/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Generated load-test artifacts, synthetic data and portable verification tools.
.nt-runs/
.nt-tools/
.pytest-nt-*/
config/nt-runner.json
