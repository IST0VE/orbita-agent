    {
      "type": "table",
      "title": "Заведены Orbita и остальные",
      "description": "Задачи с меткой orbita-op-… против остальных задач доски. Разные выборки: Orbita выбирали для одних задач и не выбирали для других, поэтому это наблюдение, а не доказательство.",
      "id": 15,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "orbita-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "orbita-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN orbita THEN 'Заведены Orbita' ELSE 'Остальные' END AS \"Группа\", count(*) AS \"Закрыто\", round((percentile_cont(0.5) WITHIN GROUP (ORDER BY cycle_days))::numeric, 1) AS \"Время в работе p50, дн.\", round(100 * avg(CASE WHEN analysis_returns > 0 THEN 1.0 WHEN analysis_returns IS NULL THEN NULL ELSE 0 END)) AS \"Возвращались в аналитику, %\" FROM flow_issues WHERE board_id = $board AND NOT subtask AND $__timeFilter(done_at) GROUP BY orbita ORDER BY orbita DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
