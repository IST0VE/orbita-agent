    {
      "type": "table",
      "title": "Спринты доски",
      "description": "Взятое на старте, закрытое из взятого, изменение объёма и перенос. Выполнено — закрыто из взятого к взятому на старте.",
      "id": 13,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "orbita-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "orbita-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT name AS \"Спринт\", CASE state WHEN 'closed' THEN 'закрыт' WHEN 'active' THEN 'идёт' ELSE state END AS \"Состояние\", start_at AS \"Старт\", committed_count AS \"Взято\", round(committed_points::numeric, 1) AS \"Взято, оценка\", completed_committed_count AS \"Закрыто из взятого\", added_count AS \"Добавлено\", removed_count AS \"Убрано\", carried_count AS \"Перенесено\", round(100.0 * completed_committed_count / NULLIF(committed_count, 0)) AS \"Выполнено, %\" FROM flow_sprints WHERE board_id = $board AND $__timeFilter(start_at) ORDER BY start_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
