# Orbita — шаблон настроек backend.
# Скопируйте в .env в корне проекта. Не перезаписывайте существующий .env.
# Запуск: docs/GETTING_STARTED.md. Справочник: docs/CONFIGURATION.md.
# Изменения применяются после перезапуска backend; для Docker пересоздайте контейнер.
# Окружение процесса важнее файла. Пусто обычно означает default, флаги — 1/0.
# Первый локальный прогон: PUBLISH_TARGET=file, JIRA_CREATE_ISSUES=0.

# ========================================================================
# Модель и инструменты
# ========================================================================
# deepseek, openai или anthropic
LLM_PROVIDER=deepseek

# Ключ модели. Возможен fallback на DEEPSEEK_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY адаптера провайдера.
LLM_API_KEY=

# Переопределение адреса API, например для корпоративного шлюза
LLM_API_BASE=

# Точное имя доступной вам модели. При смене LLM_PROVIDER измените также LLM_MODEL.
LLM_MODEL=deepseek-v4-flash

# Выбор протокола инструментов
LLM_TOOL_MODE=auto

# Температура генерации: рекомендации зависят от модели и режима thinking.
# Например, у Qwen3.8-Flash-Next: 1.0 с thinking, 0.7 без thinking.
LLM_TEMPERATURE=0

# Дополнительные параметры OpenAI-совместимого шлюза, JSON; пусто — не передавать.
# Например, для Qwen через vLLM: {"chat_template_kwargs":{"enable_thinking":false}}
# Для Qwen Cloud: {"enable_thinking":false}. Формат зависит от шлюза.
LLM_EXTRA_BODY=

# Повторы одного запроса при обрыве связи, таймауте, HTTP 408/409/429/5xx.
# Каждая попытка учитывается в очереди RPM/TPM; пауза растёт от 5 до 60 с.
# Retry-After шлюза соблюдается и при большей паузе. 0 — без повторов.
LLM_MAX_RETRIES=2

# Потолок генерации, включая reasoning; пусто или 0 — лимит провайдера.
# Оборванный ответ останавливает прогон; все токены могут уйти в рассуждения
LLM_MAX_TOKENS=

# Таймаут одного запроса, секунды; пусто — поведение клиента. Ответ приходит целиком,
# поэтому таймаут должен вмещать весь потолок: при ~30 ток/с 8000 токенов — около 5 минут
LLM_TIMEOUT_S=

# Ограничение истории; по умолчанию 0, без обрезки
LLM_MAX_HISTORY_TOKENS=

# Лимит частоты шлюза перед моделью: запросов в минуту. 0 — не ограничивать.
# Цифру берут из ответа шлюза (x-ratelimit-*-limit-requests) и ставят чуть
# меньше: минуту он считает по своим часам. Без неё роль с инструментами
# отбивается кодом 429 на середине прогона.
LLM_REQUESTS_PER_MINUTE=

# Лимит частоты шлюза: токенов в минуту, вход вместе с ответом. 0 — не
# ограничивать. Если лимит сопоставим с размером одной истории, задайте вместе
# с ним LLM_MAX_HISTORY_TOKENS: иначе один запрос съедает всё минутное окно.
# Например, при лимите шлюза около 300000 TPM начните с 270000 (запас 10%).
LLM_TOKENS_PER_MINUTE=


# ========================================================================
# Тарифы: USD за миллион токенов. Пусто — снимок prices.toml; для своей модели задайте реальные тарифы.
# ========================================================================
# Входные токены из кеша
PRICE_CACHE_HIT_PER_MTOK=

# Входные токены вне кеша
PRICE_CACHE_MISS_PER_MTOK=

# Выходные токены
PRICE_OUTPUT_PER_MTOK=

# Запись кеша для провайдеров с отдельной категорией
PRICE_CACHE_WRITE_PER_MTOK=


# ========================================================================
# Бюджет и служебный API
# ========================================================================
# Бюджет треда в USD. 0 — без лимита. Проверяется накопленная стоимость до следующего вызова; сам вызов может превысить остаток.
BUDGET_USD_PER_THREAD=0
# Что делать, когда денежный лимит включён, а тариф модели неизвестен или неполон.
# block (по умолчанию) — не обращаться к модели: проверить лимит нечем, а нулевая
# стоимость пропускала бы любой вызов. allow — денежный лимит к прогону не
# применяется; это видно в состоянии и в сообщении оператору. Ограничения на
# число ходов и на историю действуют в обоих режимах.
BUDGET_UNKNOWN_PRICE=block
# Сколько раз за прогон роль может сходить в инструменты. 0 — без потолка. Исчерпав его, роль делает последний ход без инструментов и пишет документ по прочитанному.
TOOL_TURNS_PER_RUN=12

# Имя в заголовках и подписях
AGENT_NAME=Orbita

# Обязательный Bearer-токен всего API, включая LangGraph. 32–256 ASCII-символов.
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Пустое/короткое значение закрывает API (503). Из UI токен менять нельзя.
API_ADMIN_TOKEN=

# Токен Prometheus: открывает только GET /metrics и больше ничего. Случайная
# строка от 16 символов; up.cmd / up.sh создают её сами. Нужен профилю
# monitoring в Compose (COMPOSE_PROFILES=monitoring): Grafana на
# 127.0.0.1:3000 (ORBITA_GRAFANA_PORT), Prometheus на 127.0.0.1:9090
# (ORBITA_PROMETHEUS_PORT). См. docs/MONITORING.md. Из интерфейса не меняется.
METRICS_TOKEN=

# Пароль базы Orbita — сервис postgres в Compose: личные подключения
# пользователей и чекпоинты демо. Латиница и цифры, чтобы строка подключения
# обошлась без экранирования; up.cmd / up.sh создают его сами. Задаётся до
# первого запуска базы: у готового тома pgdata пароль уже свой.
POSTGRES_PASSWORD=

# Ключ шифрования личных токенов Jira и Confluence: случайная строка от 32
# символов, up.cmd / up.sh создают её сами. Лежит только здесь, отдельно от
# базы, — копия базы без него бесполезна. Потерян — пользователи введут токены
# заново. Сменить: новый сюда, прежний — в USER_SECRETS_OLD_KEYS (через
# запятую), записи перешифруются при следующем сохранении. Из интерфейса не меняется.
USER_SECRETS_KEY=
USER_SECRETS_OLD_KEYS=

# Лимит тела запроса всего API, включая запросы без Content-Length
API_MAX_REQUEST_BYTES=65536

# Вход пользователей через Keycloak (OIDC). Пусто — только API_ADMIN_TOKEN.
# Issuer realm в том виде, в каком его видит браузер: `iss` токена обязан
# совпасть. Локальный Keycloak из Compose: http://localhost:8180/realms/orbita
# (docker compose --profile auth up -d; пользователи analyst/analyst и tester/tester,
# lead/lead с ролью администратора, guest/guest без роли).
# Из интерфейса эти настройки не меняются: от них зависит, кому API верит.
OIDC_ISSUER=
# Клиент realm, которым входит интерфейс (публичный, PKCE S256)
OIDC_CLIENT_ID=orbita-web
# Адрес ключей подписи, если серверу realm виден не так, как браузеру. Пусто —
# <issuer>/protocol/openid-connect/certs. Агенту в Compose с Keycloak из Compose:
# http://keycloak:8080/realms/orbita/protocol/openid-connect/certs
# Рядом с ключами сервер берёт и token endpoint (…/token): код входа на токены
# меняет он, а не браузер, — политика страницы пускает браузер только к API.
OIDC_JWKS_URL=
# Роль realm или клиента, без которой API отвечает 403. Пусто — любой вошедший.
OIDC_REQUIRED_ROLE=
# Роль администратора: настройки сервера (эта страница) и журнал сервера.
# Остальным вошедшим открыты только свои треды и свои подключения Jira и Confluence.
OIDC_ADMIN_ROLE=orbita-admin


# ========================================================================
# Материалы задачи
# ========================================================================
# Общая библиотека примеров: папки отсюда видят все, файл из них копируется в чат
AGENT_INPUT_DIR=input

# Файлы, загруженные в чаты: папка на тред, видна только владельцу треда
CHAT_FILES_DIR=data/chats

# Потолок одного загружаемого файла, байты
CHAT_FILE_MAX_BYTES=5242880

# Лимит символов при чтении. Для готового пакета и update учитывается общий объём. Для загрузчика пакетов используйте положительное число; подробнее docs/INPUTS.md.
AGENT_INPUT_MAX_CHARS=20000

# Ограничение представления разобранной схемы
DIAGRAM_MAX_CHARS=60000


# ========================================================================
# Справочные документы
# ========================================================================
# Включить подбор справочных документов
KNOWLEDGE_ENABLED=0

# Папка с *.md; пусто — встроенные справочные разделы
KNOWLEDGE_DIR=

# Число подставляемых документов
KNOWLEDGE_TOP_K=2

# Порог релевантности
KNOWLEDGE_MIN_SCORE=0.05


# ========================================================================
# Память между тредами
# ========================================================================
# Память между тредами, если передан store
MEMORY_ENABLED=1

# Пространство имён памяти
MEMORY_NAMESPACE=orbita

# Число фактов на аккаунт
MEMORY_MAX_FACTS=5

# Как находить ID аккаунта в тексте
MEMORY_ACCOUNT_PATTERN=acc-[0-9]+


# ========================================================================
# Этапы и публикация
# ========================================================================
# Согласование переходов между ролями обычных конвейеров
PIPELINE_REQUIRE_APPROVAL=0
# На каких воротах спрашивать при PIPELINE_REQUIRE_APPROVAL=1: all — перед каждым этапом; first — только после первого документа, на котором стоят все остальные.
PIPELINE_APPROVAL_STAGES=all

# auto — Confluence при заполненных реквизитах, иначе файлы; confluence — только wiki; file — Markdown; none — только состояние. auto не переключается на файлы после ошибки HTTP.
PUBLISH_TARGET=auto

# Папка локальных результатов
PUBLISH_DIR=published

# Согласие перед публикацией: 1 — ждать оператора, 0 — писать автоматически. В update сохранение всегда требует согласия.
PUBLISH_REQUIRE_APPROVAL=1


# ========================================================================
# Confluence: адрес, доступ и публикация
# ========================================================================
# Адрес сервера; для Cloud в конфигурации используется база с /wiki
CONFLUENCE_BASE_URL=

# 0; исключение для удалённого HTTP
CONFLUENCE_ALLOW_INSECURE_HTTP=0

# Токен API или PAT. С входом через Keycloak здесь общий токен админ-токена
# (скрипты, CI); пользователи задают свои в «Настройки → Мои подключения».
CONFLUENCE_TOKEN=

# Задан — Basic email/token; пусто — Bearer
CONFLUENCE_EMAIL=

# Ключ пространства для v1. Общий по умолчанию: у пользователя своё — в «Мои подключения»
CONFLUENCE_SPACE_KEY=

# Числовой ID пространства для v2. Общий по умолчанию, как и ключ пространства
CONFLUENCE_SPACE_ID=

# Необязательный родитель новых страниц в общем пространстве. Пользователю со своим
# пространством не подставляется: страница из другого пространства ему не родитель
CONFLUENCE_PARENT_PAGE_ID=

# Необязательная основа заголовка
CONFLUENCE_PAGE_TITLE=

# **Общий выключатель публикации, включая файлы**; историческое имя
CONFLUENCE_PUBLISH=1

# each — каждый прогон; changed — при изменении; manual — только с configurable.publish=true. Для обычного UI оставьте each.
CONFLUENCE_PUBLISH_MODE=each

# v1; также реализован v2
CONFLUENCE_API_VERSION=v1

# REST-путь публикации: v1 /rest/api/content, v2 /api/v2/pages. Меняйте вместе с CONFLUENCE_API_VERSION.
CONFLUENCE_API_PATH=/rest/api/content

# 30, секунды на запрос
CONFLUENCE_TIMEOUT_S=30


# ========================================================================
# Частота запросов Atlassian и повторы блокировок
# ========================================================================
# Пауза между запросами
ATLASSIAN_REQUEST_INTERVAL_S=10

# Переопределение для Confluence
CONFLUENCE_REQUEST_INTERVAL_S=

# Переопределение для Jira
JIRA_REQUEST_INTERVAL_S=

# Повторы распознанной блокировки шлюза
ATLASSIAN_BLOCK_RETRIES=3

# База задержки между такими повторами
ATLASSIAN_BLOCK_BACKOFF_S=15

# Подпись HTTP-клиента; по умолчанию из имени агента
ATLASSIAN_USER_AGENT=


# ========================================================================
# Оформление и чтение Confluence
# ========================================================================
# Пусто — формируется из имени агента
CONFLUENCE_VERSION_MESSAGE=

# 80, ограничение заголовка
CONFLUENCE_TITLE_MAX_LEN=80

# 10, число ходов в собираемой истории
CONFLUENCE_MAX_TURNS=10

# 0, включать ли ответы инструментов в публикуемый текст
CONFLUENCE_INCLUDE_TOOL_OUTPUT=0

# Дополнительные regex маскирования публикации. Разделитель: ||. Вход перед отправкой модели этим параметром не очищается.
CONFLUENCE_MASK_PATTERNS=

# ***, текст замены
CONFLUENCE_MASK_REPLACEMENT=***

# /rest/api/content/search; поиск настраивается отдельно от версии публикации
CONFLUENCE_SEARCH_PATH=/rest/api/content/search

# 8, число результатов поиска
CONFLUENCE_SEARCH_LIMIT=8

# 12000, ограничение прочитанной страницы
CONFLUENCE_READ_MAX_CHARS=12000


# ========================================================================
# Jira: чтение и создание задач
# ========================================================================
# Адрес сервера
JIRA_BASE_URL=

# 0, исключение для удалённого HTTP
JIRA_ALLOW_INSECURE_HTTP=0

# Токен API или PAT. С входом через Keycloak здесь общий токен админ-токена
# (скрипты, CI); пользователи задают свои в «Настройки → Мои подключения».
JIRA_TOKEN=

# Задан — Basic email/token; пусто — Bearer
JIRA_EMAIL=

# /rest/api/3; для диалекта Server/DC используйте /rest/api/2
JIRA_API_PATH=/rest/api/3

# Пусто — путь выбирается по диалекту API
JIRA_SEARCH_PATH=

# 30, секунды
JIRA_TIMEOUT_S=30

# 10, число результатов
JIRA_SEARCH_LIMIT=10

# 20, число комментариев
JIRA_COMMENTS_LIMIT=20

# 12000, ограничение текста задачи
JIRA_READ_MAX_CHARS=12000

# Проект по умолчанию для всех; у пользователя свой — в «Мои подключения», в прогоне — выбор в UI
JIRA_PROJECT_KEY=

# 1; для первого локального прогона выставьте 0
JIRA_CREATE_ISSUES=1
# Журнал операций записи в Jira: что уже отправлено и чем кончилось. Переживает
# перезапуск, поэтому повтор узла не заводит задачи второй раз — он находит
# заведённое по устойчивой метке операции. Относительный путь — от рабочей папки.
JIRA_JOURNAL_PATH=data/jira-operations.sqlite3

# 1, согласование создания задач
JIRA_CREATE_REQUIRE_APPROVAL=1

# 50, предел задач в плане
JIRA_MAX_ISSUES=50

# Epic, название типа эпика
JIRA_EPIC_TYPE=Epic

# Task, запасной тип задачи
JIRA_DEFAULT_ISSUE_TYPE=Task

# Поле связи с эпиком для соответствующей схемы Server/DC
JIRA_EPIC_LINK_FIELD=


# ========================================================================
# CLI-демо
# ========================================================================
# Тред трёх ходов run_demo.py
DEMO_THREAD_ID=demo-thread-1

# Ограничение печати ответа демо, не генерации
DEMO_ANSWER_CHARS=600


# ========================================================================
# Хранение собственного рантайма. langgraph dev управляет состоянием отдельно.
# ========================================================================
# memory или postgres для собственного Python-рантайма
CHECKPOINT_BACKEND=memory

# База Orbita: личные подключения и чекпоинты собственного рантайма. В Compose
# адрес задаёт docker-compose.yml (хост postgres); с хоста база видна на
# 127.0.0.1:5433 (ORBITA_POSTGRES_PORT) — для запуска агента без Docker:
# postgresql://orbita:<POSTGRES_PASSWORD>@localhost:5433/orbita
POSTGRES_URI=postgresql://orbita:orbita@localhost:5432/orbita

# ========================================================================
# НТ: анализ завершённого теста. Карта exporters и эксплуатация: docs/NT.md
# Ни нагрузка, ни управляющие команды автоматически не запускаются.
# ========================================================================
NT_PROMETHEUS_URL=
NT_PROMETHEUS_TOKEN=
NT_INFLUX_URL=
NT_INFLUX_TOKEN=
# 2 (Flux) или 3 (SQL)
NT_INFLUX_VERSION=2
# Bucket для v2, database для v3
NT_INFLUX_DATABASE=
NT_INFLUX_ORG=
NT_KUBERNETES_URL=
NT_KUBERNETES_TOKEN=
# Опциональный read-only gateway с GET /tests/{id} и /tests/{id}/results
NT_LOAD_TESTING_URL=
NT_LOAD_TESTING_TOKEN=
# JSON: каноническая метрика -> {profile, prometheus: шаблон, influx: mapping}
# PromQL должен содержать {{namespace}}; единицы проверяются по metric_profiles.py.
NT_METRIC_QUERIES={}
NT_STEP_SECONDS=30
# Источники, телеметрия которых симулируется (через запятую: prometheus, influx).
# Их ряды не измеряют реакцию цели на прогон, поэтому PASSED по ним превращается
# в INCONCLUSIVE с причиной, а наблюдаемая устойчивая RPS не показывается.
# Нужно для стенда nt-testbed; на боевых источниках оставьте пустым.
NT_SIMULATED_SOURCES=
NT_BASELINE_SECONDS=600
NT_MAX_WINDOW_SECONDS=86400
NT_CONCURRENCY=4
NT_MAX_SERIES=500
NT_MAX_POINTS=200000
NT_TOP_N=5
# Ходы исследования, 1..8. Каждый вызов инструментов тратит ход, а последний
# нужен модели под итоговый JSON: с discovery и составленным запросом четырёх
# ходов не хватает.
NT_MAX_INVESTIGATION_CALLS=4
NT_TIMEOUT_SECONDS=300
NT_STABLE_SECONDS=60
# Исключаем начало каждого плато и указанный во входе ramp_up_seconds.
NT_SETTLING_SECONDS=30
# Полный разброс RPS внутри плато относительно минимума, проценты (1..30).
NT_PLATEAU_TOLERANCE_PERCENT=10
# Пусто — стандартные веса. В непустой карте отсутствующие виды имеют вес 0.
NT_ANOMALY_WEIGHTS={}

# Вход модели под её окно. Бриф исследования и ответ инструмента уходят в историю
# одним сообщением: LLM_MAX_HISTORY_TOKENS выбрасывает сообщение целиком, но не
# делает его короче, поэтому размер задаётся до отправки. Постоянная часть вызова
# — промпт и схемы инструментов — около 1 800 токенов. При значениях по умолчанию
# бриф занимает до 12 000 токенов; для модели с окном 7 000 берите 2500 и 500
# вместе с LLM_MAX_HISTORY_TOKENS=4000. Урезанный бриф уменьшает число улик
# у модели (в нём появляется omitted_evidence) и не влияет на вердикт по SLA:
# его, полноту диагностики и отчёт считает код.
NT_BRIEF_TOKENS=12000
NT_TOOL_RESULT_TOKENS=2000

# Запросы, которые составляет модель. Выключено по умолчанию: карта метрик выше
# остаётся единственным источником для вердикта по SLA. Включённое значение
# добавляет исследованию два read-only инструмента — discover_metrics (какие
# метрики вообще есть у сервиса в период теста) и run_metric_query (выполнить
# составленный моделью PromQL). Ряды такого запроса идут только в улики: единицы
# у них не проверены, и на PASSED/FAILED они не влияют.
NT_GENERATED_QUERIES=0
# Сколько метрик показывать модели за один discover_metrics.
NT_DISCOVERY_LIMIT=40
# Потолок диапазона в селекторе составленного запроса, секунды.
NT_QUERY_RANGE_SECONDS=900
# Когда спрашивать оператора перед выполнением инструмента:
#   generated — только составленные моделью запросы (по умолчанию);
#   all       — любой вызов инструмента в исследовании;
#   off       — не спрашивать. Годится для прогонов по стенду, не для боевого.
NT_TOOL_APPROVAL=generated

# Separate nt_run graph; the historical nt graph remains read-only.
NT_RUNNER_URL=http://127.0.0.1:8077
# Set the same random token (at least 16 characters) for Orbita and the runner.
# up.cmd / up.sh generate it; in Docker Compose the runner URL is http://runner:8077.
NT_RUNNER_TOKEN=
NT_RUN_MAX_STEPS=16
NT_RUN_MAX_RUNS=2
# Server-only policy: 0 asks once per concrete scenario before smoke + load.
NT_RUN_AUTO_APPROVE=0
