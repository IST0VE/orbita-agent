# Orbita — шаблон настроек backend.
# Скопируйте в .env в корне проекта. Не перезаписывайте существующий .env.
# Запуск: docs/GETTING_STARTED.md. Справочник: docs/CONFIGURATION.md.
# Изменения применяются после перезапуска backend; для Docker пересоздайте контейнер.
# Окружение процесса важнее файла. Пусто обычно означает default, флаги — 1/0.
# Первый локальный прогон: PUBLISH_TARGET=file, JIRA_CREATE_ISSUES=0.

# ========================================================================
# Модель и инструменты
# ========================================================================
# deepseek, openai или anthropic
LLM_PROVIDER=deepseek

# Ключ модели. Возможен fallback на DEEPSEEK_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY адаптера провайдера.
LLM_API_KEY=

# Переопределение адреса API, например для корпоративного шлюза
LLM_API_BASE=

# Точное имя доступной вам модели. При смене LLM_PROVIDER измените также LLM_MODEL.
LLM_MODEL=deepseek-v4-flash

# Выбор протокола инструментов
LLM_TOOL_MODE=auto

# Параметр генерации
LLM_TEMPERATURE=0

# Повторы запросов при поддерживаемых клиентом временных ошибках
LLM_MAX_RETRIES=2

# Ограничение длины ответа; пусто — поведение адаптера
LLM_MAX_TOKENS=

# Таймаут одного запроса; пусто — поведение клиента
LLM_TIMEOUT_S=

# Ограничение истории; по умолчанию 0, без обрезки
LLM_MAX_HISTORY_TOKENS=


# ========================================================================
# Тарифы: USD за миллион токенов. Пусто — снимок prices.toml; для своей модели задайте реальные тарифы.
# ========================================================================
# Входные токены из кеша
PRICE_CACHE_HIT_PER_MTOK=

# Входные токены вне кеша
PRICE_CACHE_MISS_PER_MTOK=

# Выходные токены
PRICE_OUTPUT_PER_MTOK=

# Запись кеша для провайдеров с отдельной категорией
PRICE_CACHE_WRITE_PER_MTOK=


# ========================================================================
# Бюджет и служебный API
# ========================================================================
# Бюджет треда в USD. 0 — без лимита. Проверяется накопленная стоимость до следующего вызова; сам вызов может превысить остаток.
BUDGET_USD_PER_THREAD=0

# Имя в заголовках и подписях
AGENT_NAME=Orbita

# Обязательный Bearer-токен всего API, включая LangGraph. 32–256 ASCII-символов.
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Пустое/короткое значение закрывает API (503). Из UI токен менять нельзя.
API_ADMIN_TOKEN=

# Пароль PostgreSQL для Compose; отдельное случайное URL-safe значение.
# Нужен только для Docker Compose. Генерация — как выше, отдельным вызовом.
POSTGRES_PASSWORD=

# Лимит тела запроса всего API, включая запросы без Content-Length
API_MAX_REQUEST_BYTES=65536


# ========================================================================
# Материалы задачи
# ========================================================================
# Корень папок задач
AGENT_INPUT_DIR=input

# Лимит символов при чтении. Для готового пакета и update учитывается общий объём. Для загрузчика пакетов используйте положительное число; подробнее docs/INPUTS.md.
AGENT_INPUT_MAX_CHARS=20000

# Ограничение представления разобранной схемы
DIAGRAM_MAX_CHARS=60000


# ========================================================================
# Справочные документы
# ========================================================================
# Включить подбор справочных документов
KNOWLEDGE_ENABLED=0

# Папка с *.md; пусто — встроенные справочные разделы
KNOWLEDGE_DIR=

# Число подставляемых документов
KNOWLEDGE_TOP_K=2

# Порог релевантности
KNOWLEDGE_MIN_SCORE=0.05


# ========================================================================
# Память между тредами
# ========================================================================
# Память между тредами, если передан store
MEMORY_ENABLED=1

# Пространство имён памяти
MEMORY_NAMESPACE=orbita

# Число фактов на аккаунт
MEMORY_MAX_FACTS=5

# Как находить ID аккаунта в тексте
MEMORY_ACCOUNT_PATTERN=acc-[0-9]+


# ========================================================================
# Этапы и публикация
# ========================================================================
# Согласование переходов между ролями обычных конвейеров
PIPELINE_REQUIRE_APPROVAL=0

# auto — Confluence при заполненных реквизитах, иначе файлы; confluence — только wiki; file — Markdown; none — только состояние. auto не переключается на файлы после ошибки HTTP.
PUBLISH_TARGET=auto

# Папка локальных результатов
PUBLISH_DIR=published

# Согласие перед публикацией: 1 — ждать оператора, 0 — писать автоматически. В update сохранение всегда требует согласия.
PUBLISH_REQUIRE_APPROVAL=1


# ========================================================================
# Confluence: адрес, доступ и публикация
# ========================================================================
# Адрес сервера; для Cloud в конфигурации используется база с /wiki
CONFLUENCE_BASE_URL=

# 0; исключение для удалённого HTTP
CONFLUENCE_ALLOW_INSECURE_HTTP=0

# Токен API или PAT
CONFLUENCE_TOKEN=

# Задан — Basic email/token; пусто — Bearer
CONFLUENCE_EMAIL=

# Ключ пространства для v1
CONFLUENCE_SPACE_KEY=

# Числовой ID пространства для v2
CONFLUENCE_SPACE_ID=

# Необязательный родитель новых страниц
CONFLUENCE_PARENT_PAGE_ID=

# Необязательная основа заголовка
CONFLUENCE_PAGE_TITLE=

# **Общий выключатель публикации, включая файлы**; историческое имя
CONFLUENCE_PUBLISH=1

# each — каждый прогон; changed — при изменении; manual — только с configurable.publish=true. Для обычного UI оставьте each.
CONFLUENCE_PUBLISH_MODE=each

# v1; также реализован v2
CONFLUENCE_API_VERSION=v1

# REST-путь публикации: v1 /rest/api/content, v2 /api/v2/pages. Меняйте вместе с CONFLUENCE_API_VERSION.
CONFLUENCE_API_PATH=/rest/api/content

# 30, секунды на запрос
CONFLUENCE_TIMEOUT_S=30


# ========================================================================
# Частота запросов Atlassian и повторы блокировок
# ========================================================================
# Пауза между запросами
ATLASSIAN_REQUEST_INTERVAL_S=10

# Переопределение для Confluence
CONFLUENCE_REQUEST_INTERVAL_S=

# Переопределение для Jira
JIRA_REQUEST_INTERVAL_S=

# Повторы распознанной блокировки шлюза
ATLASSIAN_BLOCK_RETRIES=3

# База задержки между такими повторами
ATLASSIAN_BLOCK_BACKOFF_S=15

# Подпись HTTP-клиента; по умолчанию из имени агента
ATLASSIAN_USER_AGENT=


# ========================================================================
# Оформление и чтение Confluence
# ========================================================================
# Пусто — формируется из имени агента
CONFLUENCE_VERSION_MESSAGE=

# 80, ограничение заголовка
CONFLUENCE_TITLE_MAX_LEN=80

# 10, число ходов в собираемой истории
CONFLUENCE_MAX_TURNS=10

# 0, включать ли ответы инструментов в публикуемый текст
CONFLUENCE_INCLUDE_TOOL_OUTPUT=0

# Дополнительные regex маскирования публикации. Разделитель: ||. Вход перед отправкой модели этим параметром не очищается.
CONFLUENCE_MASK_PATTERNS=

# ***, текст замены
CONFLUENCE_MASK_REPLACEMENT=***

# /rest/api/content/search; поиск настраивается отдельно от версии публикации
CONFLUENCE_SEARCH_PATH=/rest/api/content/search

# 8, число результатов поиска
CONFLUENCE_SEARCH_LIMIT=8

# 12000, ограничение прочитанной страницы
CONFLUENCE_READ_MAX_CHARS=12000


# ========================================================================
# Jira: чтение и создание задач
# ========================================================================
# Адрес сервера
JIRA_BASE_URL=

# 0, исключение для удалённого HTTP
JIRA_ALLOW_INSECURE_HTTP=0

# Токен API или PAT
JIRA_TOKEN=

# Задан — Basic email/token; пусто — Bearer
JIRA_EMAIL=

# /rest/api/3; для диалекта Server/DC используйте /rest/api/2
JIRA_API_PATH=/rest/api/3

# Пусто — путь выбирается по диалекту API
JIRA_SEARCH_PATH=

# 30, секунды
JIRA_TIMEOUT_S=30

# 10, число результатов
JIRA_SEARCH_LIMIT=10

# 20, число комментариев
JIRA_COMMENTS_LIMIT=20

# 12000, ограничение текста задачи
JIRA_READ_MAX_CHARS=12000

# Проект по умолчанию; можно выбрать в UI
JIRA_PROJECT_KEY=

# 1; для первого локального прогона выставьте 0
JIRA_CREATE_ISSUES=1

# 1, согласование создания задач
JIRA_CREATE_REQUIRE_APPROVAL=1

# 50, предел задач в плане
JIRA_MAX_ISSUES=50

# Epic, название типа эпика
JIRA_EPIC_TYPE=Epic

# Task, запасной тип задачи
JIRA_DEFAULT_ISSUE_TYPE=Task

# Поле связи с эпиком для соответствующей схемы Server/DC
JIRA_EPIC_LINK_FIELD=


# ========================================================================
# CLI-демо
# ========================================================================
# Тред трёх ходов run_demo.py
DEMO_THREAD_ID=demo-thread-1

# Ограничение печати ответа демо, не генерации
DEMO_ANSWER_CHARS=600


# ========================================================================
# Хранение собственного рантайма. langgraph dev управляет состоянием отдельно.
# ========================================================================
# memory или postgres для собственного Python-рантайма
CHECKPOINT_BACKEND=memory

# Подключение PostgreSQL для собственного Python-рантайма. В Compose база доступна по хосту postgres; на хост порт штатно не опубликован.
POSTGRES_URI=postgresql://orbita:orbita@localhost:5432/orbita
